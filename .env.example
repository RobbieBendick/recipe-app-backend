APP_ENV=development
PORT=8080
ALLOWED_ORIGIN=*

# Prefer one of these (Neon / Vercel):
DATABASE_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_URL=

# Auth (required in production)
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Kroger Public API (price estimates) — set on the BACKEND host (Vercel), not frontend.
# Certification apps (portal shows "… - Certification") must use api-ce:
KROGER_API_BASE_URL=https://api-ce.kroger.com/v1
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Production apps would use: https://api.kroger.com/v1
# Fixed store ZIP for estimates (default 45202)
KROGER_DEFAULT_ZIP=45202

# Gemini (recipe URL import + shopping-list photos) — set on the BACKEND host (Vercel), not frontend.
GEMINI_API_KEY=
# Optional model override (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional
# DATABASE_POOL_MAX_CONNS=5
# HTTP_WRITE_TIMEOUT_SEC=120
